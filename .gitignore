# Python environment and caches (rebuilt from pyproject.toml, never saved)
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Downloaded and processed data. These files are large and can be
# downloaded again, so we keep them out of git.
# The leading "/" means only the top-level data folder, not src/.../data.
# "/data/*" (not "/data/") lets us re-include single files below.
/data/*
*.fits

# Exceptions: the two small files that define the pilot results (2.3 MB).
# They let a second laptop run scripts 05-08 without re-downloading 1 GB,
# and they record exactly which views and model PP1 used.
!/data/processed/
/data/processed/*
!/data/processed/views.npz
!/data/models/
/data/models/*
!/data/models/cnn_pilot.pt

# Jupyter auto-save files
.ipynb_checkpoints/

# Docs is private: learning notes, lessons and group proposal documents
# (which contain other members' names and student IDs). It must never be
# committed or pushed.
/Docs/

# Word lock files
~$*

# Secrets, if we ever need any. Never commit these.
.env
